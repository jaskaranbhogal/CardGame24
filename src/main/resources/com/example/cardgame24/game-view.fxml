<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER"
      spacing="22.0"
      prefHeight="550.0"
      prefWidth="700.0"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.cardgame24.GameController">

    <padding>
        <Insets top="28.0" right="30.0" bottom="28.0" left="30.0"/>
    </padding>

    <Label text="CARD GAME - 24"
           style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

    <HBox alignment="CENTER" spacing="12.0">
        <Button text="Find a Solution" prefWidth="130.0"/>
        <TextField prefWidth="260.0"
                   editable="false"
                   promptText="Solution appears here"/>
        <Button text="Refresh" prefWidth="100.0"/>
    </HBox>

    <HBox alignment="CENTER" spacing="18.0">
        <StackPane prefWidth="120.0"
                   prefHeight="175.0"
                   style="-fx-border-color: #808080; -fx-border-width: 2; -fx-background-color: white;">
            <Label text="Card 1"/>
        </StackPane>

        <StackPane prefWidth="120.0"
                   prefHeight="175.0"
                   style="-fx-border-color: #808080; -fx-border-width: 2; -fx-background-color: white;">
            <Label text="Card 2"/>
        </StackPane>

        <StackPane prefWidth="120.0"
                   prefHeight="175.0"
                   style="-fx-border-color: #808080; -fx-border-width: 2; -fx-background-color: white;">
            <Label text="Card 3"/>
        </StackPane>

        <StackPane prefWidth="120.0"
                   prefHeight="175.0"
                   style="-fx-border-color: #808080; -fx-border-width: 2; -fx-background-color: white;">
            <Label text="Card 4"/>
        </StackPane>
    </HBox>

    <Label text="Use all four card values exactly once to create an expression that equals 24."
           style="-fx-font-size: 14px;"/>

    <HBox alignment="CENTER" spacing="10.0">
        <Label text="Enter an expression:"
               style="-fx-font-weight: bold;"/>
        <TextField fx:id="expressionField"
                   prefWidth="300.0"
                   promptText="Example: (8 - 2) * (5 - 1)"/>
        <Button text="Verify" prefWidth="90.0"/>
    </HBox>

</VBox>
